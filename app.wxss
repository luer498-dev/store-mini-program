@import '/style.wxss';

page {
  background: #f5f7fb;
  padding: 24rpx;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card, .list-box, .stat-box {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(0,0,0,0.04);
}

.title, .subtitle, .greet, .role {
  display: block;
  margin-bottom: 12rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
}

.subtitle {
  font-size: 30rpx;
  font-weight: 600;
}

.header {
  background: linear-gradient(135deg, #2d7ff9, #4b8ef7);
  color: white;
  border-radius: 22rpx;
  padding: 30rpx 22rpx;
  margin-bottom: 20rpx;
}

.greet {
  font-size: 36rpx;
  font-weight: 700;
}

.role {
  font-size: 24rpx;
  opacity: 0.9;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin: 20rpx 0;
}

.tile {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 150rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.08);
}

.input {
  height: 82rpx;
  border: 1px solid #ebedf0;
  border-radius: 16rpx;
  padding: 0 18rpx;
  margin-top: 16rpx;
  background: #fff;
}

.primary-btn, .danger-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  border: none;
  margin-top: 18rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.primary-btn {
  background: #2d7ff9;
}

.danger-btn {
  background: #e74c3c;
}

.picker-row {
  height: 82rpx;
  border: 1px solid #ebedf0;
  border-radius: 16rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  background: #fff;
  margin-top: 16rpx;
}

.list-item, .rank-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-bottom: 1px solid #f0f0f0;
  padding: 18rpx 0;
}

.big {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  margin-top: 12rpx;
}
